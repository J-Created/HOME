---
// [PENDENTE] Logo provisória redesenhada a partir das imagens enviadas.
// Substituir pelos SVGs originais quando chegarem em REFERÊNCIAS.
import { LOGO_PATH } from '../../lib/logo';

interface Props {
  variant?: 'full' | 'symbol';
  tone?: 'light' | 'dark';
  /** 'load': desenha ao carregar · 'reveal': desenha quando entra na tela */
  draw?: 'load' | 'reveal';
  class?: string;
}

const { variant = 'full', tone = 'dark', draw, class: className } = Astro.props;
const viewBox = variant === 'full' ? '34 30 300 136' : '25 25 150 150';
---

<svg
  class:list={['logo', `logo-${tone}`, draw && `logo-draw logo-draw-${draw}`, className]}
  viewBox={viewBox}
  role="img"
  aria-label="J.Created"
  xmlns="http://www.w3.org/2000/svg"
  data-reveal={draw === 'reveal' ? '' : undefined}
>
  <path class="logo-stroke" d={LOGO_PATH} fill="none" stroke-width="7" stroke-linejoin="round" pathLength="1"></path>
  <circle class="logo-dot" cx="41" cy="157" r="7.5"></circle>
  {
    variant === 'full' && (
      <text class="logo-text" x="104" y="157" font-size="70" aria-hidden="true">
        reated
      </text>
    )
  }
</svg>

<style>
  .logo {
    display: block;
    height: auto;
    overflow: visible;
  }

  .logo-dark .logo-stroke {
    stroke: var(--c-blue-900);
  }

  .logo-dark .logo-text {
    fill: var(--c-blue-900);
  }

  .logo-light .logo-stroke {
    stroke: var(--c-white);
  }

  .logo-light .logo-text {
    fill: var(--c-white);
  }

  .logo-dot {
    fill: var(--c-blue-500);
  }

  .logo-text {
    font-family: var(--font-sans);
    font-style: italic;
    font-weight: 400;
    letter-spacing: 0.01em;
  }

  /* Desenho do traço contínuo */
  :global(.js) .logo-draw .logo-stroke {
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
  }

  :global(.js) .logo-draw .logo-dot,
  :global(.js) .logo-draw .logo-text {
    opacity: 0;
  }

  :global(.js) .logo-draw-load .logo-stroke,
  :global(.js) .logo-draw-reveal.is-visible .logo-stroke {
    animation: logo-stroke 1.6s var(--ease-out) 0.2s forwards;
  }

  :global(.js) .logo-draw-load .logo-dot,
  :global(.js) .logo-draw-reveal.is-visible .logo-dot {
    animation: logo-pop 500ms var(--ease-out) 1.5s forwards;
  }

  :global(.js) .logo-draw-load .logo-text,
  :global(.js) .logo-draw-reveal.is-visible .logo-text {
    animation: logo-fade 700ms var(--ease-out) 1.2s forwards;
  }

  /* O revelar padrão (fade + translate) não se aplica a SVGs desenhados */
  :global(.js) .logo-draw-reveal[data-reveal] {
    opacity: 1;
    transform: none;
  }

  @keyframes logo-stroke {
    to {
      stroke-dashoffset: 0;
    }
  }

  @keyframes logo-pop {
    from {
      opacity: 0;
      transform: scale(0.2);
    }
    to {
      opacity: 1;
      transform: scale(1);
    }
  }

  @keyframes logo-fade {
    to {
      opacity: 1;
    }
  }

  .logo-dot {
    transform-box: fill-box;
    transform-origin: center;
  }
</style>
