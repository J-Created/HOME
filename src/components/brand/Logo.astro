---
// [PENDENTE] Logo provisória redesenhada a partir das imagens enviadas.
// Substituir pelos SVGs originais quando chegarem em REFERÊNCIAS.
interface Props {
  variant?: 'full' | 'symbol';
  tone?: 'light' | 'dark';
  class?: string;
}

const { variant = 'full', tone = 'dark', class: className } = Astro.props;
const viewBox = variant === 'full' ? '34 30 300 136' : '25 25 150 150';
---

<svg
  class:list={['logo', `logo-${tone}`, className]}
  viewBox={viewBox}
  role="img"
  aria-label="J.Created"
  xmlns="http://www.w3.org/2000/svg"
>
  <path
    class="logo-stroke"
    d="M128 37 H163 L150 88 C146 103 138 108 128 108 C118 108 112 101 106 95 C99 89 93 87 85 87 C66 87 50 103 50 123 C50 142 65 157 84 157 C93 157 100 154 107 149"
    fill="none"
    stroke-width="7"
    stroke-linejoin="round"
  ></path>
  <circle class="logo-dot" cx="41" cy="157" r="7.5"></circle>
  {
    variant === 'full' && (
      <text class="logo-text" x="104" y="157" font-size="70" aria-hidden="true">
        reated
      </text>
    )
  }
</svg>

<style>
  .logo {
    display: block;
    height: auto;
  }

  .logo-dark .logo-stroke {
    stroke: var(--c-blue-900);
  }

  .logo-dark .logo-text {
    fill: var(--c-blue-900);
  }

  .logo-light .logo-stroke {
    stroke: var(--c-white);
  }

  .logo-light .logo-text {
    fill: var(--c-white);
  }

  .logo-dot {
    fill: var(--c-blue-500);
  }

  .logo-text {
    font-family: var(--font-sans);
    font-style: italic;
    font-weight: 400;
    letter-spacing: 0.01em;
  }
</style>
