---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from './layout/Header.astro';
import Footer from './layout/Footer.astro';
import FloatingWhatsApp from './layout/FloatingWhatsApp.astro';
import Hero from './sections/Hero.astro';
import Ecosystem from './sections/Ecosystem.astro';
import Services from './sections/Services.astro';
import Differential from './sections/Differential.astro';
import About from './sections/About.astro';
import Contact from './sections/Contact.astro';
import { getContent, type Lang } from '../i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const content = getContent(lang);
---

<BaseLayout
  title={content.meta.title}
  description={content.meta.description}
  htmlLang={content.meta.htmlLang}
  restoreLang={lang === 'pt'}
>
  <a class="skip-link" href="#conteudo">{content.ui.skip}</a>
  <Header content={content} lang={lang} />

  <main id="conteudo">
    <Hero content={content} />
    <Ecosystem content={content} />
    <Services content={content} />
    <Differential content={content} />
    <!-- Portfólio: fora do site até existir material real e autorizado (specs/site.md) -->
    <About content={content} />
    <Contact content={content} />
  </main>

  <Footer content={content} lang={lang} />
  <FloatingWhatsApp content={content} />
</BaseLayout>

<script>
  // Revelação suave ao rolar
  const items = document.querySelectorAll('[data-reveal]');
  if ('IntersectionObserver' in window) {
    const io = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add('is-visible');
            io.unobserve(entry.target);
          }
        });
      },
      { rootMargin: '0px 0px -10% 0px', threshold: 0.1 },
    );
    items.forEach((el) => io.observe(el));
  } else {
    items.forEach((el) => el.classList.add('is-visible'));
  }
</script>
