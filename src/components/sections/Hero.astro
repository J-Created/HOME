---
import Glow from '../ui/Glow.astro';
import Button from '../ui/Button.astro';
import Container from '../ui/Container.astro';
import type { Content } from '../../i18n/pt';
import { whatsappUrl } from '../../lib/whatsapp';

interface Props {
  content: Content;
}

const { content } = Astro.props;
const { hero, whatsapp } = content;
---

<section class="hero" aria-labelledby="hero-title">
  <Glow position="top-right" />
  <Container class="hero-inner">
    <h1 id="hero-title" class="hero-title">
      <span class="visually-hidden">{hero.srTitle}</span>
      <span class="hero-words" aria-hidden="true">
        {
          hero.words.map((word, i) => (
            <span class="hero-word" style={`--i: ${i}`}>{word}<span class="dot">.</span></span>
          ))
        }
      </span>
    </h1>

    <div class="hero-bottom">
      <div class="hero-copy">
        <p class="hero-slogan">{hero.slogan}</p>
        <p class="hero-support">{hero.support}</p>
        <div class="hero-actions">
          <Button href={whatsappUrl(whatsapp.message)} variant="inverse" icon="whatsapp" external ariaLabel={whatsapp.ctaLabel}>
            {whatsapp.cta}
          </Button>
          <Button href="#servicos" variant="secondary" icon="down">{hero.secondary}</Button>
        </div>
      </div>
      <p class="hero-signature serif" aria-hidden="true">{hero.signature}</p>
    </div>
  </Container>
</section>

<style>
  .hero {
    position: relative;
    display: flex;
    min-height: 100svh;
    padding-block: calc(var(--header-h) + var(--s-7)) var(--s-8);
    overflow: hidden;
    isolation: isolate;
    background: var(--c-night);
    color: var(--c-white);
  }

  :global(.hero-inner) {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: var(--s-8);
  }

  .hero-title {
    margin-top: auto;
    font-size: var(--fs-display);
    font-weight: 800;
    line-height: var(--lh-display);
    letter-spacing: var(--ls-display);
  }

  .hero-words {
    display: flex;
    flex-direction: column;
  }

  /* Escada: recuos escalonados, como na peça de referência */
  .hero-word {
    display: block;
    white-space: nowrap;
  }

  .hero-word:nth-child(1) {
    padding-left: 0.9em;
  }

  .hero-word:nth-child(2) {
    padding-left: 0.35em;
  }

  .hero-word:nth-child(4) {
    padding-left: 2.6em;
  }

  .hero-bottom {
    display: grid;
    gap: var(--s-7);
    align-items: end;
  }

  .hero-slogan {
    font-size: var(--fs-h2);
    font-weight: 700;
    line-height: 1.1;
    letter-spacing: -0.02em;
  }

  .hero-support {
    margin-top: var(--s-4);
    max-width: 46ch;
    color: var(--c-white-70);
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-3);
    margin-top: var(--s-6);
  }

  .hero-signature {
    font-size: var(--fs-serif);
    line-height: 1;
    color: var(--c-blue-300);
  }

  /* Entrada: palavras sobem em sequência e a serifada aparece por último */
  .js .hero-word {
    opacity: 0;
    transform: translateY(0.25em);
    animation: hero-in 900ms var(--ease-out) forwards;
    animation-delay: calc(150ms + var(--i) * 110ms);
  }

  .js .hero-signature {
    opacity: 0;
    animation: hero-fade 900ms var(--ease-out) 750ms forwards;
  }

  .js .hero-copy {
    opacity: 0;
    animation: hero-fade 900ms var(--ease-out) 600ms forwards;
  }

  @keyframes hero-in {
    to {
      opacity: 1;
      transform: none;
    }
  }

  @keyframes hero-fade {
    to {
      opacity: 1;
    }
  }

  @media (max-width: 767px) {
    .hero-word:nth-child(1) {
      padding-left: 0.5em;
    }

    .hero-word:nth-child(2) {
      padding-left: 0.2em;
    }

    .hero-word:nth-child(4) {
      padding-left: 1.6em;
    }

    .hero-actions :global(.btn) {
      width: 100%;
    }
  }

  @media (min-width: 1024px) {
    .hero-bottom {
      grid-template-columns: 1fr auto;
    }

    .hero-signature {
      padding-bottom: var(--s-2);
    }
  }
</style>
