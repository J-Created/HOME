---
import Container from '../ui/Container.astro';
import Glow from '../ui/Glow.astro';
import type { Content } from '../../i18n/pt';

interface Props {
  content: Content;
}

const { services } = Astro.props.content;

// Ícones lineares, com a espessura do traço da logo
const icons: Record<string, string> = {
  filmmaker:
    '<rect x="6" y="18" width="40" height="28" rx="6"/><path d="M46 28 L58 21 V43 L46 36"/><circle cx="18" cy="12" r="6"/><circle cx="34" cy="12" r="6"/>',
  design:
    '<path d="M10 54 L22 42"/><path d="M22 42 L42 10 L54 22 L22 42 Z"/><circle cx="40" cy="24" r="3"/><path d="M8 58 H30"/>',
  site: '<rect x="6" y="10" width="52" height="40" rx="6"/><path d="M6 22 H58"/><circle cx="14" cy="16" r="1.5"/><circle cx="20" cy="16" r="1.5"/><path d="M18 34 L24 30 L18 26 M30 38 H42"/>',
  ia: '<circle cx="32" cy="32" r="8"/><circle cx="12" cy="14" r="4"/><circle cx="52" cy="14" r="4"/><circle cx="12" cy="50" r="4"/><circle cx="52" cy="50" r="4"/><path d="M15 17 L26 27 M49 17 L38 27 M15 47 L26 37 M49 47 L38 37"/>',
};
---

<section id="servicos" class="services" aria-labelledby="servicos-title">
  <Container class="services-intro">
    <div class="services-head" data-reveal>
      <div>
        <p class="eyebrow">{services.eyebrow}</p>
        <h2 id="servicos-title" class="section-title">
          {services.title} <span class="serif">{services.titleSerif}</span>
        </h2>
      </div>
      <p class="lead services-support">{services.support}</p>
    </div>
  </Container>

  <ol class="scenes">
    {
      services.items.map((item, i) => (
        <li class:list={['scene', `scene-${i % 2 ? 'dark' : 'night'}`, 'grain']} style={`--i: ${i}`}>
          {i === 0 && <Glow position="top-right" size="md" />}
          <Container class="scene-inner">
            <span class="scene-number" aria-hidden="true">
              {String(i + 1).padStart(2, '0')}
            </span>
            <div class="scene-body" data-reveal>
              <svg class="scene-icon" viewBox="0 0 64 64" aria-hidden="true" set:html={icons[item.id]} />
              <h3 class="scene-title">{item.title}</h3>
              <p class="scene-text">{item.text}</p>
              <p class="scene-detail">{item.detail}</p>
            </div>
          </Container>
        </li>
      ))
    }
  </ol>
</section>

<style>
  .services {
    position: relative;
    background: var(--c-night);
    color: var(--c-white);
  }

  :global(.services-intro) {
    padding-block: var(--section-y) var(--s-8);
  }

  .services-head {
    display: grid;
    gap: var(--s-5);
    align-items: end;
  }

  .services-head .eyebrow {
    margin-bottom: var(--s-4);
    color: var(--c-blue-300);
  }

  .services-head :global(.section-title .serif) {
    color: var(--c-blue-300);
  }

  .services-support {
    color: var(--c-white-70);
    max-width: 40ch;
  }

  .scenes {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .scene {
    position: relative;
    overflow: hidden;
    isolation: isolate;
    border-top: 1px solid var(--c-line);
  }

  .scene-night {
    background: var(--c-night);
  }

  .scene-dark {
    background: var(--c-blue-900);
  }

  :global(.scene-inner) {
    position: relative;
    z-index: 1;
    display: grid;
    gap: var(--s-6);
    padding-block: var(--s-9);
  }

  .scene-number {
    font-size: clamp(7rem, 26vw, 22rem);
    font-weight: 800;
    line-height: 0.8;
    letter-spacing: -0.06em;
    color: transparent;
    -webkit-text-stroke: 1.5px rgb(158 201 243 / 0.45);
  }

  .scene-body {
    display: grid;
    gap: var(--s-5);
    max-width: 34rem;
  }

  .scene-icon {
    width: 56px;
    height: 56px;
    fill: none;
    stroke: var(--c-blue-300);
    stroke-width: 2.5;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .scene-title {
    font-size: clamp(3rem, 8vw, 6.5rem);
    font-weight: 800;
    line-height: 0.95;
    letter-spacing: -0.04em;
  }

  .scene-text {
    font-size: var(--fs-lead);
    color: var(--c-white-70);
  }

  .scene-detail {
    width: fit-content;
    padding: var(--s-2) var(--s-4);
    border: 1px solid var(--c-line);
    border-radius: var(--r-pill);
    font-size: var(--fs-small);
    font-weight: 500;
    color: var(--c-blue-300);
  }

  @media (min-width: 1024px) {
    .services-head {
      grid-template-columns: 1.2fr 1fr;
    }

    /* Cenas que se empilham ao rolar */
    .scene {
      position: sticky;
      top: 0;
      min-height: 100svh;
      display: flex;
      align-items: center;
      box-shadow: 0 -24px 60px rgb(0 0 0 / 0.35);
    }

    :global(.scene-inner) {
      grid-template-columns: 1fr 1fr;
      align-items: center;
      gap: var(--s-9);
    }

    .scene:nth-child(even) .scene-number {
      order: 2;
      text-align: right;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .scene {
      position: relative;
    }
  }
</style>
