---
import Section from '../ui/Section.astro';
import Card from '../ui/Card.astro';
import type { Content } from '../../i18n/pt';

interface Props {
  content: Content;
}

const { services } = Astro.props.content;
---

<Section id="servicos" tone="tint" labelledby="servicos-title">
  <div class="services-head" data-reveal>
    <div>
      <p class="eyebrow">{services.eyebrow}</p>
      <h2 id="servicos-title" class="section-title">
        {services.title} <span class="serif">{services.titleSerif}</span>
      </h2>
    </div>
    <p class="lead services-support">{services.support}</p>
  </div>

  <ul class="services-grid">
    {
      services.items.map((item, i) => (
        <li>
          <Card index={String(i + 1).padStart(2, '0')} title={item.title} detail={item.detail}>
            <p>{item.text}</p>
          </Card>
        </li>
      ))
    }
  </ul>
</Section>

<style>
  .services-head {
    display: grid;
    gap: var(--s-5);
    align-items: end;
  }

  .services-head .eyebrow {
    margin-bottom: var(--s-4);
  }

  .services-support {
    color: var(--c-ink-70);
    max-width: 40ch;
  }

  .services-grid {
    display: grid;
    gap: var(--s-4);
    margin: var(--s-8) 0 0;
    padding: 0;
    list-style: none;
  }

  @media (min-width: 768px) {
    .services-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: var(--s-5);
    }
  }

  @media (min-width: 1024px) {
    .services-head {
      grid-template-columns: 1.2fr 1fr;
    }
  }

  @media (min-width: 1280px) {
    .services-grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }
</style>
