---
// Botão flutuante do WhatsApp — só no celular/tablet (specs/design.md §12)
import type { Content } from '../../i18n/pt';
import { whatsappUrl } from '../../lib/whatsapp';

interface Props {
  content: Content;
}

const { whatsapp } = Astro.props.content;
---

<a
  class="fab is-hidden"
  href={whatsappUrl(whatsapp.message)}
  target="_blank"
  rel="noopener noreferrer"
  aria-label={whatsapp.ctaLabel}
  data-fab
  tabindex="-1"
  aria-hidden="true"
>
  <svg viewBox="0 0 24 24" width="26" height="26" aria-hidden="true" fill="currentColor">
    <path d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2Zm0 18.2a8.2 8.2 0 0 1-4.2-1.2l-.3-.2-3 .8.8-2.9-.2-.3A8.2 8.2 0 1 1 12 20.2Zm4.5-6.1c-.2-.1-1.5-.7-1.7-.8-.2-.1-.4-.1-.6.1l-.8 1c-.1.2-.3.2-.5.1a6.7 6.7 0 0 1-3.3-2.9c-.3-.4.2-.4.7-1.4.1-.2 0-.3 0-.4l-.8-1.8c-.2-.5-.4-.4-.6-.4h-.5a1 1 0 0 0-.7.3 3 3 0 0 0-.9 2.2 5.2 5.2 0 0 0 1.1 2.7 11.8 11.8 0 0 0 4.5 4c1.7.7 2.3.8 3.2.6.5-.1 1.5-.6 1.7-1.2.2-.6.2-1.1.2-1.2-.1-.1-.3-.2-.5-.3Z" />
  </svg>
</a>

<script>
  // Aparece depois do hero (que já tem o botão) e some quando o formulário está visível
  const fab = document.querySelector<HTMLAnchorElement>('[data-fab]');
  const hero = document.querySelector('.hero');
  const contact = document.getElementById('contato');

  if (fab && hero && contact && 'IntersectionObserver' in window) {
    const state = { hero: true, contact: false };

    const update = () => {
      const menuOpen = document.querySelector('[data-header]')?.classList.contains('menu-open');
      const hidden = state.hero || state.contact || Boolean(menuOpen);
      fab.classList.toggle('is-hidden', hidden);
      fab.setAttribute('aria-hidden', String(hidden));
      fab.tabIndex = hidden ? -1 : 0;
    };

    new IntersectionObserver(([entry]) => {
      state.hero = entry.isIntersecting;
      update();
    }).observe(hero);

    new IntersectionObserver(
      ([entry]) => {
        state.contact = entry.isIntersecting;
        update();
      },
      { threshold: 0.15 },
    ).observe(contact);

    new MutationObserver(update).observe(document.querySelector('[data-header]')!, {
      attributes: true,
      attributeFilter: ['class'],
    });
  }
</script>

<style>
  .fab {
    position: fixed;
    right: calc(var(--s-4) + env(safe-area-inset-right));
    bottom: calc(var(--s-4) + env(safe-area-inset-bottom));
    z-index: 40;
    display: grid;
    place-items: center;
    width: 56px;
    height: 56px;
    border-radius: 50%;
    background: var(--c-blue-500);
    color: var(--c-white);
    box-shadow: 0 8px 24px rgb(14 26 46 / 0.28);
    transition:
      opacity var(--t-fast) var(--ease-out),
      transform var(--t-fast) var(--ease-out),
      visibility var(--t-fast);
  }

  .fab:hover {
    background: #2867ad;
  }

  .fab.is-hidden {
    opacity: 0;
    visibility: hidden;
    transform: translateY(12px) scale(0.9);
  }

  @media (min-width: 1024px) {
    .fab {
      display: none;
    }
  }
</style>
